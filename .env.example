NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials. Never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional marketing-agent model. Defaults to gpt-5.4-mini, then OPENAI_MODEL.
OPENAI_REFERENCE_MODEL=gpt-5.4-mini

# Apify public Instagram reference discovery
APIFY_API_TOKEN=

# Meta / Instagram API
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v23.0
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
